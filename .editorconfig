root = true

[*.cs]

indent_style = space
indent_size = 4

dotnet_sort_system_directives_first = true

dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion



# MA0004  will be kept , 
# but it is ok
# my async methon is not async because it uses windows function that is sync

# MA0011 is for Form.cs that is only Prototype of UI
# actually in Logform.cs that should not ve shown often

#  changed   rules for analyzer  

dotnet_diagnostic.IDE0055.severity = warning # warning formating wrong 
dotnet_diagnostic.IDE0005.severity = warning # warning unused imports 

#  disabled  rules for analyzer  
# not important the project's current project  coding/maintenance approach.
dotnet_diagnostic.MA0026.severity = none # warning there is TODO in project 
dotnet_diagnostic.MA0051.severity = none # warning method too log > 60


# for sonar 
[*.cs]
dotnet_diagnostic.S125.severity = none # warningremove this commented out code
[QuickCopier.Core/Logging/*.cs] # changed for all those files
dotnet_diagnostic.S2139.severity = none # it is expected behavious if ogging is made with decorator
# warning Either log this exception and handle it, or rethrow it with some contextual information.

# for other
[*.cs]
dotnet_diagnostic.SA1413.severity = none # warning ttrailing coma missing
dotnet_diagnostic.SA1101.severity = none # warning  pure formating ScanWasCalled = true; sould be this.ScanWasCalled = true;

[*.cs]
# Temporarily disable all StyleCop rules
dotnet_analyzer_diagnostic.category-StyleCop.severity = none

[QuickCopier.App/Form1.cs] #
dotnet_analyzer_diagnostic.category-IDisposableAnalyzers.severity = none


